{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/museum-api/:path*",
      "destination": "https://api.artic.edu/api/v1/:path*"
    },
    {
      "source": "/museum-images/:path*",
      "destination": "https://www.artic.edu/iiif/2/:path*"
    }
  ]
}
