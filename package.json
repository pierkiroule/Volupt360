{
  "name": "volupt360",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:sensory": "node --experimental-strip-types --test tests/sensory-engine.unit.ts",
    "textures:placeholders": "node scripts/generate-texture-placeholders.mjs",
    "test:studio": "playwright test tests/studio.spec.js",
    "test:studio:offline": "playwright test tests/studio-offline.spec.js"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tonaljs/tonal": "^4.10.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "smplr": "^1.1.0",
    "three": "0.164.1",
    "tone": "^15.1.22",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.164.1",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "3.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
